{
  "name": "coi-nguon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-service-worker.mjs",
    "build:cloud": "npm run typecheck && node --experimental-strip-types scripts/prepare-cloud.mjs",
    "build:local": "npm run typecheck && node scripts/prepare-local.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && vitest run --config automation_test/vitest.backend.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config automation_test/playwright.config.ts",
    "emulators": "node scripts/firebase.mjs emulators:start --only auth,firestore,storage",
    "emulators:auth": "node scripts/firebase.mjs emulators:start --only auth",
    "test:rules": "node scripts/firebase.mjs emulators:exec --only firestore \"node node_modules/vitest/vitest.mjs run --config automation_test/vitest.rules.config.ts\"",
    "format": "prettier --write src backend automation_test scripts/*.mjs scripts/service-worker.js *.ts *.json eslint.config.js",
    "format:check": "prettier --check src backend automation_test scripts/*.mjs scripts/service-worker.js *.ts *.json eslint.config.js",
    "emulators:check": "node scripts/firebase.mjs emulators:exec --only auth,firestore,storage \"node scripts/check-emulators.mjs\"",
    "test:workspace": "node scripts/firebase.mjs emulators:exec --only auth,firestore \"node node_modules/@playwright/test/cli.js test --config automation_test/playwright.workspace.config.ts\"",
    "api": "node scripts/run-cloud.mjs",
    "test:genealogy": "npm run test:api",
    "preview:workspace": "node scripts/preview.mjs",
    "test:offline": "node scripts/firebase.mjs emulators:exec --only auth,firestore \"node node_modules/@playwright/test/cli.js test --config automation_test/playwright.offline.config.ts\"",
    "test:api": "node scripts/firebase.mjs emulators:exec --only auth,firestore \"node node_modules/vitest/vitest.mjs run --config automation_test/vitest.api.config.ts\"",
    "test:feature": "node automation_test/scripts/run-feature.mjs",
    "test:all": "node automation_test/scripts/run-all.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset-and-seed": "node scripts/with-emulators.mjs \"node scripts/seed.mjs\"",
    "test:e2e:multi": "node scripts/with-emulators.mjs \"node node_modules/@playwright/test/cli.js test --config automation_test/playwright.workspace.config.ts\"",
    "verify:all": "node scripts/with-emulators.mjs \"npm run db:reset-and-seed && npm run typecheck && npm run test:e2e && npm run test:e2e:multi\"",
    "test:ai:unit": "vitest run --reporter=dot --bail=1",
    "test:ai:e2e": "playwright test --config automation_test/playwright.ai.config.ts --reporter=line --max-failures=1 --trace=off"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.62.0",
    "lunar-date-vn": "1.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.34.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
