# Copy to .env.local (ignored by Git). Restart Vite or rebuild after edits.
# local: demo emulators; staging/production: real Firebase, all four fields required.
VITE_APP_ENV=local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# VITE_* values are public. Never put server credentials or secrets here.
# Cloud frontend defaults to /api; local defaults to the API emulator URL.
VITE_API_BASE_URL=
# Backend on Cloud Run: APP_ENV=staging, APP_ROLE=api (or worker).
# FIREBASE_PROJECT_ID=your-project-id
# ALLOWED_ORIGINS=https://your-project-id.web.app
# PHONE_LOOKUP_HMAC_KEY is injected from Secret Manager, never VITE_*.
# Credentials use the Cloud Run service identity (ADC), not the web apiKey.
